PORT=8080
GCS_BUCKET_NAME=your-cloud-storage-bucket-name  # comma-separated for multiple buckets, e.g. bucket-a,bucket-b
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GEMINI_API_KEY=your-gemini-api-key
SERVICE_ACCOUNT_FILE=  # optional: path to service account key JSON for all Google Cloud clients (uses ADC if unset)
GEMINI_MODEL=  # optional: defaults to gemini-3.1-flash-lite-preview
MAX_UPLOAD_SIZE_MB=  # optional: defaults to 32
CORS_ORIGIN=  # optional: comma-separated allowed origins (all origins are allowed when NODE_ENV is not production)
IAP_AUDIENCE=  # optional: verify IAP-signed JWTs for this audience on every API request
